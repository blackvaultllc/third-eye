{"dependencies":{"cors":"^2.8.5","express":"^4.19.2","multer":"^1.4.5-lts.1"},"description":"Third Eye analysis backend: ffmpeg extraction, provider adapters, async scan jobs. API keys live here only, never in the app.","devDependencies":{"@types/cors":"^2.8.17","@types/express":"^4.17.21","@types/multer":"^1.4.12","@types/node":"^20.14.0","ts-node-dev":"^2.0.0","typescript":"^5.5.0"},"main":"dist/index.js","name":"third-eye-server","private":true,"scripts":{"build":"tsc -p tsconfig.json","dev":"ts-node-dev --respawn --transpile-only src/index.ts","start":"node dist/index.js","test":"node --test test/*.test.js"},"version":"0.1.0"}