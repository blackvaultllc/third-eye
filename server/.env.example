# Copy to .env. NEVER commit a real .env, and NEVER put these keys in the app.
PORT=4000
# Visual provider: hive | bitmind | mock   (mock = local demo only, flagged demo:true)
VISUAL_PROVIDER=mock
HIVE_API_KEY=
BITMIND_API_KEY=
# Voice provider: resemble | mock
VOICE_PROVIDER=mock
RESEMBLE_API_KEY=
# Optional provider endpoint overrides — verify against the provider's current docs
# before production. The adapters send frames/audio to these endpoints server-side.
HIVE_ENDPOINT=
BITMIND_ENDPOINT=
RESEMBLE_DETECT_ENDPOINT=
# Where uploads land before deletion. Must be on the same host as ffmpeg.
UPLOAD_DIR=./uploads
# Seconds a finished job (and its verdict, not the video) is kept for polling.
JOB_TTL_SECONDS=3600
# Max clip the server will accept. Share-sheet clips should already be trimmed client-side.
MAX_UPLOAD_MB=200
